NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Never prefix these private keys with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
RESEND_FROM=Coach Studio <appointments@your-verified-domain.com>
SITE_URL=https://your-project.vercel.app
CRON_SECRET=

# Contacts management key: Full access; separate from the Sending access key.
RESEND_CONTACTS_API_KEY=
# Dedicated fitness segment; existing contacts global subscriptions are preserved.
RESEND_SEGMENT_ID=

# Stripe: disabled until test checkout + webhook verification succeeds.
# Use a restricted server key. Never expose either secret to the browser.
STRIPE_MODE=disabled
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
